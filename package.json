    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "fast-check": "^3.23.2",
    "postcss": "^8.4.49",
